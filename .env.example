PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=baas_user
DB_PASSWORD=baas_password
DB_NAME=baas_db

JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

# Só usado pelo `docker compose up --build` (build arg do serviço frontend).
# Local/dev: deixe como está. Em VPS/produção, troque pra URL pública da API.
VITE_API_URL=http://localhost:3000/api
